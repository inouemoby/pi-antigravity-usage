{
  "name": "pi-antigravity-usage",
  "version": "0.2.0",
  "description": "Google Antigravity subscription usage monitor for Pi coding agent. Displays 5-hour rolling limit and weekly quota in the footer, matching Pi's native footer experience.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "antigravity",
    "gemini",
    "usage",
    "quota"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/inouemoby/pi-antigravity-usage.git"
  },
  "bugs": {
    "url": "https://github.com/inouemoby/pi-antigravity-usage/issues"
  },
  "homepage": "https://github.com/inouemoby/pi-antigravity-usage",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@cortexkit/antigravity-auth-core": "3.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.2.0",
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-tui": ">=1.2.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^22.15.3",
    "esbuild": "0.28.2",
    "typebox": "^1.0.86",
    "typescript": "^5.9.0"
  }
}
